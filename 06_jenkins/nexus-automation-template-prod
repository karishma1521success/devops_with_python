pipeline {
    agent any

    environment {
        NEXUS_URL = 'http://127.0.0.1:8081'
        NEXUS_USER = "admin"      // move to credentials later
        NEXUS_PASSWORD = "nexus"
    }

    stages {
        stage('Create Nexus Repositories') {
            steps {
                script {

                    // 🔹 VARIABLES (edit here only)
                    def BLOBSTORE = "asirwad-prod" 

                    def REPOS = [
                        "asirwad-prod-mcollect-core-jar",
                        "asirwad-prod-mcollect-core-integration",
                        "asirwad-prod-mcollect-core-schedular",
                        "asirwad-prod-mcollect-core-web",
                        "asirwad-prod-mcollect-core-web-adfs",
                        "asirwad-prod-mcollect-digital-collection-consumer",
                        "asirwad-prod-mcollect-digital-collection-dashboard",
                        "asirwad-prod-mcollect-digital-collection-shortener",
                        "asirwad-prod-mcollect-digital-collection-web",
                        "asirwad-prod-mcollect-digital-collection-webhook",
                       ]

                    for (repo in REPOS) {

                        echo "Creating Nexus repository: ${repo}"

                        sh """
                        curl -s -o /dev/null -w "%{http_code}" \\
                          -u ${NEXUS_USER}:${NEXUS_PASSWORD} \\
                          -X POST ${NEXUS_URL}/service/rest/v1/repositories/maven/hosted \\
                          -H "Content-Type: application/json" \\
                          -d '{
                            "name": "${repo}",
                            "online": true,
                            "storage": {
                              "blobStoreName": "${BLOBSTORE}",
                              "strictContentTypeValidation": false,
                              "writePolicy": "ALLOW"
                            },
                            "cleanup": {
                              "policyNames": ["Devops-Maven-policy"]
                            },
                            "maven": {
                              "versionPolicy": "MIXED",
                              "layoutPolicy": "PERMISSIVE"
                            },
                            "component": {
                              "proprietary": true
                            },
                            "format": "maven2",
                            "recipeName": "maven2-hosted"
                          }'
                        """
                    }
                }
            }
        }
    }
}