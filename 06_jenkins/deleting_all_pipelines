import jenkins.model.*

def dryRun = true // Set to false to actually delete the jobs
def matchedJobs = Jenkins.instance.items.findAll { job ->
    // This regex will match all jobs. You can modify it to filter if needed.
    job.name =~ /.*/ 
}

println "Found " + matchedJobs.size() + " jobs to process."

matchedJobs.each { job ->
    if (dryRun) {
        println "Dry run: " + job.name + " would be deleted."
    } else {
        println "Deleting job: " + job.name
        job.delete()
    }
}

if (!dryRun) {
    println "Deletion process finished. Reloading configuration from disk."
    Jenkins.instance.reload()
} else {
    println "Dry run complete. No jobs were deleted."
}





