pipeline {
    agent any

    /*************************************************
     * MANUAL PARAMETERS
     *************************************************/
    parameters {
        choice(
            name: 'SERVICE_NAME',
            choices: [
                'whatsapp-prutech',
                'sms-prutech',
                'api-gateway'
            ],
            description: 'Select microservice to build'
        )
        choice(
            name: 'DEPLOY_ENV',
            choices: ['uat', 'prod'],
            description: 'Target environment'
        )
    }

    /*************************************************
     * ENVIRONMENT
     *************************************************/
    environment {

        /* ===== AWS / ECR ===== */
        AWS_REGION     = 'ap-south-1'
        AWS_ACCOUNT_ID = '123362706831'

        // ECR_REPO  = "mobicule-prod-${SERVICE_NAME}-ecr"    //mobicule-prod-whatsapp-prutech-ecr
        ECR_REPO  = "mobicule-test-repo-ecr"
        IMAGE_TAG = "${DEPLOY_ENV}-2.0.${BUILD_NUMBER}"

        /* ===== SONAR ===== */
        SONAR_SERVER      = 'sonar-server'
        SONAR_PROJECT_KEY = "${SERVICE_NAME}"

        /* ===== GRADLE ===== */
        GRADLE_OPTS = "-Dorg.gradle.daemon=false"
    }

    stages {

        /* =================================================
           1. CHECKOUT FULL MONOREPO
           ================================================= */
        stage('Checkout Code') {
            steps {
                checkout scm
            }
        }

        /* =================================================
           2. SONARQUBE (MODULE-SCOPED, ROOT EXECUTION)
           ================================================= */
        stage('SonarQube Analysis') {
            steps {
                withSonarQubeEnv("${SONAR_SERVER}") {
                    sh '''
                        set -e
                        chmod +x gradlew

                        echo "Running Sonar for module: ${SERVICE_NAME}"

                        ./gradlew :${SERVICE_NAME}:sonar \
                          -Dsonar.projectKey=${SONAR_PROJECT_KEY}
                    '''
                }
            }
        }

        /* =================================================
           3. QUALITY GATE
           ================================================= */
        stage('Quality Gate') {
            steps {
                timeout(time: 5, unit: 'MINUTES') {
                    waitForQualityGate abortPipeline: true
                }
            }
        }

        /* =================================================
           4. DOCKER BUILD (ROOT CONTEXT)
           ================================================= */
        stage('Docker Build') {
            steps {
                sh '''
                    echo "Building Docker image for ${SERVICE_NAME}"
                    docker build \
                      -f ${SERVICE_NAME}/Dockerfile \
                      -t ${SERVICE_NAME}:${IMAGE_TAG} \
                      .
                '''
            }
        }

        /* =================================================
           5. PROD APPROVAL
           ================================================= */
        stage('Production Approval') {
            when {
                expression { params.DEPLOY_ENV == 'prod' }
            }
            steps {
                timeout(time: 30, unit: 'MINUTES') {
                    input message: "Approve PROD image for ${SERVICE_NAME}?",
                          ok: 'Approve',
                          submitter: 'prod-approvers'
                }
            }
        }

        /* =================================================
           6. LOGIN TO AWS ECR
           ================================================= */
        stage('Login to AWS ECR') {
            steps {
                withCredentials([[
                    $class: 'AmazonWebServicesCredentialsBinding',
                    credentialsId: 'aws-ecr-cred'
                ]]) {
                    sh '''
                        aws ecr get-login-password --region ${AWS_REGION} \
                        | docker login \
                          --username AWS \
                          --password-stdin \
                          ${AWS_ACCOUNT_ID}.dkr.ecr.${AWS_REGION}.amazonaws.com
                    '''
                }
            }
        }

        /* =================================================
           7. TAG IMAGE
           ================================================= */
        stage('Tag Image') {
            steps {
                sh '''
                    docker tag ${SERVICE_NAME}:${IMAGE_TAG} \
                    ${AWS_ACCOUNT_ID}.dkr.ecr.${AWS_REGION}.amazonaws.com/${ECR_REPO}:${IMAGE_TAG}
                '''
            }
        }

        /* =================================================
           8. PUSH IMAGE
           ================================================= */
        stage('Push Image to ECR') {
            steps {
                sh '''
                    docker push \
                    ${AWS_ACCOUNT_ID}.dkr.ecr.${AWS_REGION}.amazonaws.com/${ECR_REPO}:${IMAGE_TAG}
                '''
            }
        }
    }

    post {
        success {
            echo "✅ CI SUCCESS"
            echo "Service: ${SERVICE_NAME}"
            echo "Image: ${AWS_ACCOUNT_ID}.dkr.ecr.${AWS_REGION}.amazonaws.com/${ECR_REPO}:${IMAGE_TAG}"
        }
        failure {
            echo "❌ CI FAILED"
        }
        aborted {
            echo "⏸ PIPELINE ABORTED"
        }
        always {
            cleanWs()
        }
    }
}
