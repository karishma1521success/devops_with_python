pipeline {
  agent any

  environment {
    // ---------- AWS / ECR ----------
    AWS_REGION = 'ap-south-1'
    ECR_ACCOUNT_ID = '123456789012'
    ECR_REPO = 'communication-gateway/whatsapp-prutech'
    IMAGE_TAG = "${BUILD_NUMBER}"

    // ---------- SonarQube ----------
    SONAR_HOST_URL = 'http://127.0.0.1:9000'
    SONAR_PROJECT_KEY = 'whatsapp-prutech'
    SONAR_TOKEN = credentials('sonar-token')
  }

  stages {

    /* =====================================
       1. CHECKOUT
       ===================================== */
    stage('Checkout Code') {
      steps {
        checkout scm
      }
    }

    /* =====================================
       2. SONARQUBE ANALYSIS (GRADLE)
       ===================================== */
    stage('SonarQube Analysis') {
      steps {
        sh """
          docker run --rm \
            -v \$PWD:/build \
            -w /build \
            eclipse-temurin:21-jdk-alpine \
            sh -c '
              ./gradlew sonar \
              -Dsonar.projectKey=${SONAR_PROJECT_KEY} \
              -Dsonar.host.url=${SONAR_HOST_URL} \
              -Dsonar.token=${SONAR_TOKEN}
            '
        """
      }
    }

    /* =====================================
       3. QUALITY GATE (BLOCKER)
       ===================================== */
    stage('Quality Gate') {
      steps {
        timeout(time: 5, unit: 'MINUTES') {
          waitForQualityGate abortPipeline: true
        }
      }
    }

    /* =====================================
       4. DOCKER BUILD (WAR INSIDE)
       ===================================== */
    stage('Docker Build') {
      steps {
        sh '''
          docker build \
            -t whatsapp-prutech:${IMAGE_TAG} .
        '''
      }
    }

    /* =====================================
       5. MANUAL PROD APPROVAL
       ===================================== */
    stage('Production Approval') {
      steps {
        input message: 'Approve deployment to PRODUCTION?',
              ok: 'Approve',
              submitter: 'prod-approvers'
      }
    }

    /* =====================================
       6. LOGIN TO ECR
       ===================================== */
    stage('Login to AWS ECR') {
      steps {
        sh '''
          aws ecr get-login-password \
            --region ${AWS_REGION} \
          | docker login \
            --username AWS \
            --password-stdin \
            ${ECR_ACCOUNT_ID}.dkr.ecr.${AWS_REGION}.amazonaws.com
        '''
      }
    }

    /* =====================================
       7. TAG IMAGE
       ===================================== */
    stage('Tag Docker Image') {
      steps {
        sh '''
          docker tag whatsapp-prutech:${IMAGE_TAG} \
          ${ECR_ACCOUNT_ID}.dkr.ecr.${AWS_REGION}.amazonaws.com/${ECR_REPO}:${IMAGE_TAG}
        '''
      }
    }

    /* =====================================
       8. PUSH IMAGE TO ECR
       ===================================== */
    stage('Push Image to ECR') {
      steps {
        sh '''
          docker push \
          ${ECR_ACCOUNT_ID}.dkr.ecr.${AWS_REGION}.amazonaws.com/${ECR_REPO}:${IMAGE_TAG}
        '''
      }
    }
  }

  post {
    success {
      echo "CI completed successfully. Image pushed to ECR."
    }
    failure {
      echo "CI failed. Check logs."
    }
    aborted {
      echo "Pipeline aborted during approval."
    }
  }
}
