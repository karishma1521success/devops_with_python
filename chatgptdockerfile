pipeline {
  agent any

  environment {
    // ------------------ Git ------------------
    GIT_CREDENTIALS = 'Git-Yatinpednekar'

    // ------------------ Sonar ------------------
    SONAR_HOST_URL = 'http://127.0.0.1:9000'
    SONAR_TOKEN = credentials('sonar-token')
    SONAR_PROJECT_KEY = 'niwas-prod-core-web'

    // ------------------ Docker ------------------
    DOCKER_REGISTRY = 'registry.example.com'
    IMAGE_NAME = 'mcollect/web'
    IMAGE_TAG = "${BUILD_NUMBER}"

    // ------------------ Notifications ------------------
    RECIPIENTS = 'gourav.singh@mobicule.com'
  }

  stages {

    /* =====================================================
       PRE-CHECKS
       ===================================================== */
    stage('Pre-Checks') {
      steps {
        sh '''
          echo "Checking Docker availability"
          docker version
        '''
      }
    }

    /* =====================================================
       CHECKOUT
       ===================================================== */
    stage('Checkout Source') {
      steps {
        checkout scm
      }
    }

    /* =====================================================
       DETECT BUILD TOOL
       ===================================================== */
    stage('Detect Build Tool') {
      steps {
        script {
          if (fileExists('build.gradle')) {
            env.BUILD_TOOL = 'gradle'
          } else if (fileExists('pom.xml')) {
            env.BUILD_TOOL = 'maven'
          } else {
            error 'No build.gradle or pom.xml found'
          }
          echo "Detected build tool: ${env.BUILD_TOOL}"
        }
      }
    }

    /* =====================================================
       SONARQUBE ANALYSIS
       ===================================================== */
    stage('SonarQube Analysis') {
      steps {
        script {
          if (env.BUILD_TOOL == 'gradle') {
            sh """
              docker run --rm \
              -v \$PWD:/app \
              -w /app gradle:8.6-jdk17 \
              gradle sonar \
              -Dsonar.projectKey=${SONAR_PROJECT_KEY} \
              -Dsonar.host.url=${SONAR_HOST_URL} \
              -Dsonar.token=${SONAR_TOKEN}
            """
          } else {
            sh """
              docker run --rm \
              -v \$PWD:/app \
              -w /app maven:3.9-eclipse-temurin-17 \
              mvn sonar:sonar \
              -Dsonar.projectKey=${SONAR_PROJECT_KEY} \
              -Dsonar.host.url=${SONAR_HOST_URL} \
              -Dsonar.login=${SONAR_TOKEN}
            """
          }
        }
      }
    }

    /* =====================================================
       QUALITY GATE (BLOCKER)
       ===================================================== */
    stage('Sonar Quality Gate') {
      steps {
        timeout(time: 5, unit: 'MINUTES') {
          waitForQualityGate abortPipeline: true
        }
      }
    }

    /* =====================================================
       BUILD WAR
       ===================================================== */
    stage('Build WAR') {
      steps {
        script {
          if (env.BUILD_TOOL == 'gradle') {
            sh """
              docker run --rm \
              -v \$PWD:/app \
              -w /app gradle:8.6-jdk17 \
              gradle clean build -x test
            """
          } else {
            sh """
              docker run --rm \
              -v \$PWD:/app \
              -w /app maven:3.9-eclipse-temurin-17 \
              mvn clean package -DskipTests
            """
          }
        }
      }
    }

    /* =====================================================
       BUILD DOCKER IMAGE
       ===================================================== */
    stage('Docker Build') {
      steps {
        sh """
          docker build \
          -t ${DOCKER_REGISTRY}/${IMAGE_NAME}:${IMAGE_TAG} .
        """
      }
    }

    /* =====================================================
       MANUAL PROD APPROVAL
       ===================================================== */
    stage('Production Approval') {
      steps {
        input message: 'Approve deployment to Production?',
              ok: 'Approve',
              submitter: 'prod-approvers'
      }
    }

    /* =====================================================
       PUSH IMAGE
       ===================================================== */
    stage('Push Docker Image') {
      steps {
        withCredentials([usernamePassword(
          credentialsId: 'docker-registry-creds',
          usernameVariable: 'DOCKER_USER',
          passwordVariable: 'DOCKER_PASS'
        )]) {
          sh """
            docker login ${DOCKER_REGISTRY} -u $DOCKER_USER -p $DOCKER_PASS
            docker push ${DOCKER_REGISTRY}/${IMAGE_NAME}:${IMAGE_TAG}
          """
        }
      }
    }
  }

  post {
    success {
      emailext(
        subject: "SUCCESS: ${JOB_NAME} #${BUILD_NUMBER}",
        body: "Production CI completed successfully.",
        to: "${RECIPIENTS}"
      )
    }
    failure {
      emailext(
        subject: "FAILED: ${JOB_NAME} #${BUILD_NUMBER}",
        body: "CI failed. Immediate attention required.",
        to: "${RECIPIENTS}",
        attachLog: true
      )
    }
    aborted {
      emailext(
        subject: "ABORTED: ${JOB_NAME} #${BUILD_NUMBER}",
        body: "Pipeline was aborted during approval.",
        to: "${RECIPIENTS}"
      )
    }
  }
}
