pipeline {
    agent any

    environment {
        NEXUS_URL = 'http://127.0.0.1:8081'
        NEXUS_USER = ""      // Use appropriate Nexus admin username
        NEXUS_PASSWORD = ""  // Use appropriate Nexus admin password
    }

    stages {
        stage('Create Nexus Repositories') {
            steps {
                script {

                    // 🔹 VARIABLES (edit here only)
                    //Make sure that the blobstore 'Blobstore' and cleanup policy 'Devops-Maven-policy' are already created in Nexus
                    // If not, create them manually via Nexus UI before running this pipeline
                    def BLOBSTORE = "Blobstore_Name"    //HFS_Prod

                    def REPOS = [
                        "Repo_Name1",
                        "Repo_Name2",
                        "Repo_Name3",
                        "Repo_Name4",
                        "Repo_Name5"
                       ]

                    for (repo in REPOS) {

                        echo "Creating Nexus repository: ${repo}"

                        sh """
                        curl -s -o /dev/null -w "%{http_code}" \\
                          -u ${NEXUS_USER}:${NEXUS_PASSWORD} \\
                          -X POST ${NEXUS_URL}/service/rest/v1/repositories/maven/hosted \\
                          -H "Content-Type: application/json" \\
                          -d '{
                            "name": "${repo}",
                            "online": true,
                            "storage": {
                              "blobStoreName": "${BLOBSTORE}",
                              "strictContentTypeValidation": false,
                              "writePolicy": "ALLOW"
                            },
                            "cleanup": {
                              "policyNames": ["Devops-Maven-policy"]
                            },
                            "maven": {
                              "versionPolicy": "MIXED",
                              "layoutPolicy": "PERMISSIVE"
                            },
                            "component": {
                              "proprietary": true
                            },
                            "format": "maven2",
                            "recipeName": "maven2-hosted"
                          }'
                        """
                    }
                }
            }
        }
    }
}