pipeline {
    agent any

    /*************************************************
     * MANUAL TRIGGER ONLY
     * (No GitHub webhook / no SCM polling)
     *************************************************/
    triggers { }

    /*************************************************
     * PARAMETERS
     *************************************************/
    parameters {
        choice(
            name: 'SERVICE_NAME',
            choices: [
                'whatsapp-prutech',
                'sms-prutech',
                'api-gateway'
            ],
            description: 'Select the microservice to build'
        )
        choice(
            name: 'DEPLOY_ENV',
            choices: ['uat', 'prod'],
            description: 'Target environment'
        )
    }

    /*************************************************
     * ENVIRONMENT
     *************************************************/
    environment {

        /* ===== AWS / ECR ===== */
        AWS_REGION     = 'ap-south-1'
        AWS_ACCOUNT_ID = '123362706831'
        ECR_REPO       = "mobicule-prod-${SERVICE_NAME}-ecr"

        /* ===== SONAR ===== */
        SONAR_SERVER      = 'sonar-server'
        SONAR_PROJECT_KEY = "${SERVICE_NAME}"

        /* ===== GRADLE ===== */
        GRADLE_OPTS = "-Dorg.gradle.daemon=false"
    }

    stages {

        /* =================================================
           1. CHECKOUT FULL MONOREPO
           ================================================= */
        stage('Checkout Code') {
            steps {
                checkout scm
            }
        }

        /* =================================================
           2. RESOLVE SERVICE VERSION FROM build.gradle
           ================================================= */
        stage('Resolve Image Version') {
            steps {
                script {
                    def version = sh(
                        script: """
                            ./gradlew :${SERVICE_NAME}:properties \
                            | grep '^version:' \
                            | awk '{print \$2}'
                        """,
                        returnStdout: true
                    ).trim()

                    if (!version || version == 'unspecified') {
                        error "❌ Version not defined in ${SERVICE_NAME}/build.gradle"
                    }

                    env.SERVICE_VERSION = version
                    echo "Resolved ${SERVICE_NAME} version: ${SERVICE_VERSION}"
                }
            }
        }

        /* =================================================
           3. FINALIZE IMAGE TAG (ENV-AWARE)
           ================================================= */
        stage('Finalize Image Tag') {
            steps {
                script {
                    if (params.DEPLOY_ENV == 'prod') {
                        env.IMAGE_TAG = env.SERVICE_VERSION.replace('-SNAPSHOT', '')
                    } else {
                        env.IMAGE_TAG = "${env.SERVICE_VERSION}-${BUILD_NUMBER}"
                    }

                    echo "Docker Image Tag: ${IMAGE_TAG}"
                }
            }
        }

        /* =================================================
           4. SONARQUBE ANALYSIS (MODULE SCOPED)
           ================================================= */
        stage('SonarQube Analysis') {
            steps {
                withSonarQubeEnv("${SONAR_SERVER}") {
                    sh """
                        chmod +x gradlew
                        ./gradlew :${SERVICE_NAME}:sonar \
                          -Dsonar.projectKey=${SONAR_PROJECT_KEY}
                    """
                }
            }
        }

        /* =================================================
           5. QUALITY GATE (BLOCKER)
           ================================================= */
        stage('Quality Gate') {
            steps {
                timeout(time: 5, unit: 'MINUTES') {
                    waitForQualityGate abortPipeline: true
                }
            }
        }

        /* =================================================
           6. DOCKER BUILD (ROOT CONTEXT)
           ================================================= */
        stage('Docker Build') {
            steps {
                sh """
                    docker build \
                      -f ${SERVICE_NAME}/Dockerfile \
                      -t ${SERVICE_NAME}:${IMAGE_TAG} \
                      .
                """
            }
        }

        /* =================================================
           7. PRODUCTION APPROVAL
           ================================================= */
        stage('Production Approval') {
            when {
                expression { params.DEPLOY_ENV == 'prod' }
            }
            steps {
                timeout(time: 30, unit: 'MINUTES') {
                    input message: "Approve PROD image for ${SERVICE_NAME}?",
                          ok: 'Approve',
                          submitter: 'prod-approvers'
                }
            }
        }

        /* =================================================
           8. LOGIN TO AWS ECR
           ================================================= */
        stage('Login to AWS ECR') {
            steps {
                withCredentials([[
                    $class: 'AmazonWebServicesCredentialsBinding',
                    credentialsId: 'aws-ecr-cred'
                ]]) {
                    sh """
                        aws ecr get-login-password --region ${AWS_REGION} \
                        | docker login \
                          --username AWS \
                          --password-stdin \
                          ${AWS_ACCOUNT_ID}.dkr.ecr.${AWS_REGION}.amazonaws.com
                    """
                }
            }
        }

        /* =================================================
           9. TAG IMAGE
           ================================================= */
        stage('Tag Image') {
            steps {
                sh """
                    docker tag ${SERVICE_NAME}:${IMAGE_TAG} \
                    ${AWS_ACCOUNT_ID}.dkr.ecr.${AWS_REGION}.amazonaws.com/${ECR_REPO}:${IMAGE_TAG}
                """
            }
        }

        /* =================================================
           10. PUSH IMAGE TO ECR
           ================================================= */
        stage('Push Image to ECR') {
            steps {
                sh """
                    docker push \
                    ${AWS_ACCOUNT_ID}.dkr.ecr.${AWS_REGION}.amazonaws.com/${ECR_REPO}:${IMAGE_TAG}
                """
            }
        }
    }

    post {
        success {
            echo "✅ CI SUCCESS"
            echo "Service: ${SERVICE_NAME}"
            echo "Image: ${AWS_ACCOUNT_ID}.dkr.ecr.${AWS_REGION}.amazonaws.com/${ECR_REPO}:${IMAGE_TAG}"
        }
        failure {
            echo "❌ CI FAILED – investigate immediately"
        }
        aborted {
            echo "⏸ PIPELINE ABORTED"
        }
        always {
            cleanWs()
        }
    }
}
